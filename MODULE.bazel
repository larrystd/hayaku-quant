# Build the Python extension against one reproducible interpreter ABI.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.10")
use_repo(python, "python_3_10")

# These projects do not publish Bazel modules. Fetch immutable commits and
# verify their archives instead of depending on the machine's package cache.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "nng_src",
    urls = ["https://codeload.github.com/nanomsg/nng/tar.gz/45f8116f2dd1b0438ab77344a75628d77656c61a"],
