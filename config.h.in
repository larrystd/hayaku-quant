#pragma once

// clang-format off

// Debug mode
#define HAYAKU_DEBUG_MODE ${HAYAKU_DEBUG_MODE}

// Whether to enable the local maximum vectorization
#define HAYAKU_LOCAL_VECTORIZE ${HAYAKU_LOCAL_VECTORIZE}

// support serialization
#define HAYAKU_SUPPORT_SERIALIZATION  ${SUPPORT_SERIALIZATION}

#if HAYAKU_SUPPORT_SERIALIZATION
#define HAYAKU_SUPPORT_TEXT_ARCHIVE   ${SUPPORT_TEXT_ARCHIVE}
#define HAYAKU_SUPPORT_XML_ARCHIVE    ${SUPPORT_XML_ARCHIVE}  //must 1 for python
#define HAYAKU_SUPPORT_BINARY_ARCHIVE ${SUPPORT_BINARY_ARCHIVE}  //must 1 for python
#endif /* HAYAKU_SUPPORT_SERIALIZATION*/

// Check the subscript out of bounds
#define CHECK_ACCESS_BOUND ${CHECK_ACCESS_BOUND}

// Enable the MSVC memory leak check
#define ENABLE_MSVC_LEAK_DETECT ${ENABLE_MSVC_LEAK_DETECT}

// Enable the memory leak detection, used for the linux system
#define HAYAKU_ENABLE_LEAK_DETECT ${HAYAKU_ENABLE_LEAK_DETECT}

// Enable the sending of the user usage information
#define HAYAKU_ENABLE_SEND_FEEDBACK ${HAYAKU_ENABLE_SEND_FEEDBACK}

// Enable the hdf5 K-line data engine
#define HAYAKU_ENABLE_HDF5_KDATA ${HAYAKU_ENABLE_HDF5_KDATA}

// Enable the MySQL K-line data engine
#define HAYAKU_ENABLE_MYSQL_KDATA ${HAYAKU_ENABLE_MYSQL_KDATA}

// Enable the SQLite K-line data engine
#define HAYAKU_ENABLE_SQLITE_KDATA ${HAYAKU_ENABLE_SQLITE_KDATA}

// Enable the TDX local K-line data engine
#define HAYAKU_ENABLE_TDX_KDATA ${HAYAKU_ENABLE_TDX_KDATA}

// Use the low precision version, the Indicator is calculated with the float type
#define HAYAKU_USE_LOW_PRECISION ${HAYAKU_USE_LOW_PRECISION}

// Use TA-Lib
#define HAYAKU_ENABLE_TA_LIB ${HAYAKU_ENABLE_TA_LIB}

#define HAYAKU_ENABLE_MIMALLOC ${HAYAKU_ENABLE_MIMALLOC}

// clang-format on
